---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import FormattedDate from '../components/FormattedDate.astro';

interface SeriesNavEntry {
	title: string;
	slug: string;
	part?: number;
}

type Props = CollectionEntry<'blog'>['data'] & {
	readingTime?: number;
	headings?: MarkdownHeading[];
	seriesTotal?: number;
	prevPost?: SeriesNavEntry;
	nextPost?: SeriesNavEntry;
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	canonicalURL,
	part,
	readingTime,
	headings = [],
	seriesTotal,
	prevPost,
	nextPost,
} = Astro.props;
---

<BaseLayout title={title} description={description} canonicalURL={canonicalURL}>
	<article class="post">
		<h1>{title}</h1>
		<p class="meta">
			<FormattedDate date={pubDate} />
			{readingTime && <span> · {readingTime} min read</span>}
			{
				updatedDate && (
					<span>
						{' '}
						· updated <FormattedDate date={updatedDate} />
					</span>
				)
			}
			{
				part && seriesTotal && (
					<span>
						{' '}
						· part {part} of {seriesTotal} in the kubemend series
					</span>
				)
			}
		</p>
		{
			headings.length > 1 && (
				<nav class="toc" aria-label="Table of contents">
					<span class="toc-label">Contents</span>
					<ol>
						{headings.map((heading) => (
							<li>
								<a href={`#${heading.slug}`}>{heading.text}</a>
							</li>
						))}
					</ol>
				</nav>
			)
		}
		<div class="prose">
			<slot />
		</div>
		{
			(prevPost || nextPost) && (
				<nav class="series-nav" aria-label="Series navigation">
					{prevPost ? <a href={`/blog/${prevPost.slug}/`}>← {prevPost.title}</a> : <span />}
					{nextPost && <a href={`/blog/${nextPost.slug}/`}>{nextPost.title} →</a>}
				</nav>
			)
		}
	</article>
</BaseLayout>

<style>
	.post h1 {
		margin-bottom: 0.3em;
	}
	.meta {
		color: var(--muted);
		font-size: 0.95em;
		margin: 0 0 2em 0;
	}
	.toc {
		margin: 0 0 2.5em 0;
	}
	.toc-label {
		display: block;
		font-size: 0.8em;
		text-transform: uppercase;
		letter-spacing: 0.04em;
		color: var(--muted);
		margin-bottom: 0.6em;
	}
	.toc ol {
		margin: 0;
		padding-left: 1.2em;
	}
	.toc li {
		margin-bottom: 0.35em;
	}
	.series-nav {
		display: flex;
		justify-content: space-between;
		gap: 1em;
		margin-top: 3em;
		padding-top: 1.5em;
		border-top: 1px solid rgba(0, 0, 0, 0.08);
		font-size: 0.95em;
	}
</style>
