---
import { AVATAR_SRC, SITE_TITLE } from '../consts';
---

<header class="site-header">
	<div class="container header-inner">
		<a href="/" aria-label="Home" class="avatar-link">
			<img src={AVATAR_SRC} alt="" width="80" height="80" class="avatar" />
		</a>
		<a href="/" class="site-name">{SITE_TITLE}</a>
		<nav class="site-nav" aria-label="Primary">
			<a href="/blog">Articles</a>
			<a href="/projects">Projects</a>
			<a href="/about">About</a>
			<a href="/about#contact">Contact</a>
		</nav>
	</div>
</header>
<style>
	.header-inner {
		display: flex;
		flex-direction: column;
		align-items: center;
		text-align: center;
		padding-bottom: 0;
	}
	.avatar-link {
		display: inline-block;
		margin-bottom: 0.9em;
	}
	.avatar {
		display: block;
		border-radius: 50%;
		object-fit: cover;
	}
	.site-name {
		color: var(--text);
		font-weight: 600;
		font-size: 1.05em;
		margin-bottom: 1.2em;
	}
	.site-name:hover {
		text-decoration: none;
	}
	.site-nav {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 0.5em 1.3em;
		font-size: 0.95em;
	}
</style>
